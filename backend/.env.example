# =====================================================================
# StratosEvent Backend Environment Configuration Template
# TCS iON Industry Project
#
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to '.env' inside the 'backend' folder.
# 2. Update the values below to match your local setup.
# 3. NEVER commit your actual '.env' file or real passwords to version control.
# =====================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=stratosevent_db
DB_PORT=3306

# Connection Pool Settings
DB_CONNECTION_LIMIT=10

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_strong_secret_key_here
JWT_EXPIRES_IN=24h
