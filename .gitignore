# =====================================================================
# StratosEvent - Git Ignore Rules
# Protects secrets, node_modules, logs, and OS artifacts
# =====================================================================

# Environment variables & secrets (NEVER commit these)
.env
.env.local
.env.*.local
backend/.env
*.env

# Dependencies
node_modules/
backend/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build & runtime artifacts
dist/
build/
coverage/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# OS-specific files
.DS_Store
Thumbs.db
